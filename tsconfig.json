{
  "compilerOptions": {
    // ES2020 e nao o es5 padrao: o codigo espalha Set/Map com [...x], que em
    // es5 vira erro de compilacao. Toda plataforma que roda este sistema
    // (Node 18+ no servidor, navegadores atuais) entende ES2020 nativamente.
    "target": "es2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-preview/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
