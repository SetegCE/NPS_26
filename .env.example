# ============================================================================
# Variáveis de ambiente do Dashboard NPS.
#
# Nenhuma delas vai para o navegador. Não há prefixo `NEXT_PUBLIC_` em lugar
# nenhum: todo acesso ao banco acontece no servidor, dentro de route handlers
# e Server Components. Quem abrir o código-fonte da página não encontra
# chave alguma.
#
# Localmente:  copie este arquivo para `.env.local` e rode `npm run dev`.
# Na Vercel:   Project → Settings → Environment Variables, as três marcadas
#              para Production, Preview e Development.
#
# O .gitignore ignora `.env` e `.env.local`.
# ============================================================================

# ─── Banco: Postgres direto (servidor próprio) ──────────────────────────────
#
# Com DATABASE_URL preenchida, o sistema fala direto com o Postgres
# (lib/dbPostgres.ts) e IGNORA as variáveis SUPABASE_* abaixo. É o modo do
# servidor próprio, onde não existe a API REST do Supabase.
#
#   DATABASE_URL=postgresql://usuario:senha@localhost:5432/nps
#
# Para testar contra o Supabase atual, use a connection string do painel
# (Connect → Session pooler) e DATABASE_SSL=true.
DATABASE_URL=
# true quando o Postgres exige SSL (Supabase exige; um Postgres local não).
DATABASE_SSL=
# Conexões simultâneas no pool (padrão 10).
DATABASE_POOL_MAX=
# Schema do NPS no banco. No servidor: "nps" (banco compartilhado 7station,
# um schema por sistema — ver DEPLOY.md). Vazio = public (Supabase).
DATABASE_SCHEMA=

# ─── Servidor ───────────────────────────────────────────────────────────────
# Porta do `npm start`. Cada sistema do servidor usa a sua (o Clockrview usa
# a 3000); o túnel da Cloudflare aponta para ela.
PORT=

# ─── Banco: projeto Supabase (usado só quando DATABASE_URL está vazia) ──────
SUPABASE_URL=https://acpugxkikuzbvtjwxups.supabase.co

# Chave de SERVIÇO do Supabase. Ela ignora RLS e dá acesso total ao banco.
# Painel do Supabase → Project Settings → API → service_role (secret).
#
# NUNCA coloque esta chave no front-end nem faça commit dela. Ela só é lida
# por lib/db.ts, que roda exclusivamente no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Sessão ─────────────────────────────────────────────────────────────────
#
# Segredo que assina o JWT do cookie de sessão (HS256, via `jose`).
# Gere um valor aleatório e longo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Sem ela a aplicação NÃO SOBE — e isso é de propósito. A versão anterior
# caía para a service_role key e, se nem essa existisse, para uma string
# vazia: qualquer pessoa que lesse o repositório forjaria um token de PMO.
#
# Trocar este valor derruba todas as sessões abertas. É exatamente o que se
# faz diante de qualquer suspeita de vazamento; ninguém perde acesso, todos
# entram de novo com a mesma senha.
NPS_SESSION_SECRET=

# ─── Projetos: Clockrview ───────────────────────────────────────────────────
#
# Os projetos (código, nome, cliente, líder, ativo/inativo) vêm da API
# externa do Clockrview; o banco guarda só um espelho para manter respostas e
# ciclos ligados ao projeto. Ver lib/clockrview.ts e lib/sincronizarProjetos.ts.
CLOCKRVIEW_API_URL=https://clockrview.setegce.com/api/externo/projetos

# Chave de acesso à API (header x-api-key). Peça à equipe do Clockrview.
# Só o servidor lê: nunca coloque em código de navegador nem faça commit.
CLOCKRVIEW_API_KEY=

# Segredo da sincronização diária. Quem chama a rota manda
# `Authorization: Bearer <CRON_SECRET>` e ela confere: no servidor próprio é
# scripts/sincronizar-projetos-agendado.mjs (Agendador de Tarefas); na Vercel
# era o cron do vercel.json. Sem ele, a sincronização só acontece pelo botão
# da tela de Projetos.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# Arquivo de log da tarefa agendada de sincronização (opcional).
NPS_LOG_SINCRONIZACAO=
